{
  "name": "copyseeker-mcp-server",
  "version": "2.0.1",
  "description": "MCP server for Copyseeker: reverse image search, AI image detection and NSFW detection for Claude, Cursor, VS Code Copilot, Codex, Gemini CLI and other AI assistants",
  "type": "module",
  "bin": {
    "copyseeker-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --import tsx \"test/**/*.test.ts\"",
    "start": "node build/index.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^20.19.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "copyseeker",
    "reverse-image-search",
    "ai-image-detection",
    "nsfw-detection",
    "image-search",
    "copyright",
    "mcp-server",
    "claude",
    "cursor",
    "vscode",
    "copilot",
    "codex",
    "gemini",
    "ai-detection",
    "deepfake-detection"
  ],
  "author": "Copyseeker <support@copyseeker.net>",
  "license": "MIT",
  "homepage": "https://copyseeker.net/apis",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE"
  ],
  "mcpName": "net.copyseeker/mcp"
}
